# SAP Sales Outreach Engine — Environment Variables

# Database
DATABASE_URL=sqlite:///./sap_outreach.db

# Default AI Provider: "ollama" (local), "claude", or "openai"
DEFAULT_AI_PROVIDER=ollama

# Ollama (Local LLM) — runs entirely on your machine
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# AI API Keys (optional — only needed if using claude/openai provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Models (for cloud providers)
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# Enrichment APIs (optional)
APOLLO_API_KEY=

# Auth
SECRET_KEY=change-me-to-a-random-string-in-production
