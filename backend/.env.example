# SAP Sales Outreach Engine — Environment Variables

# Database
DATABASE_URL=sqlite:///./sap_outreach.db

# AI API Keys (at least one required for AI features)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# AI Models
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# Enrichment APIs (optional)
APOLLO_API_KEY=

# Auth
SECRET_KEY=change-me-to-a-random-string-in-production
